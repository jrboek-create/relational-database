Move-Item `
-LiteralPath $BuildDir `
-Destination $FinalDir
 
# ------------------------------------------------------------------
# 15. PASS
# ------------------------------------------------------------------
 
Write-Host ""
Write-Host "GATE 5.0 OWNERSHIP ARTIFACT GENERATION - PASS" `
-ForegroundColor Green
 
Write-Host ("ArtifactDirectory=" + $FinalDir)
 
foreach ($Count in $Counts) {
Write-Host $Count
}
 
Write-Host "TotalStatements=113"
Write-Host "InventoryRows=114"
 
Write-Host ""
Write-Host "ArtifactFingerprints:"
 
$Manifest |
Format-Table `
File,
Bytes,
SHA256 `
-AutoSize
 
Write-Host ""
Write-Host "NO GENERATED SQL WAS EXECUTED." `
-ForegroundColor Green
 
Write-Host "STOP. DO NOT EXECUTE THE GENERATED SQL FILES." `
-ForegroundColor Yellow
}
catch {
 
if (Test-Path -LiteralPath $BuildDir) {
 
if (Test-Path -LiteralPath $FailedDir) {
$FailedDir = (
$FailedDir +
"_" +
[guid]::NewGuid().ToString("N").Substring(0,8)
)
}
 
Move-Item `
-LiteralPath $BuildDir `
-Destination $FailedDir
 
Write-Host (
"FailedDirectory=" +
$FailedDir
) -ForegroundColor Yellow
}
 
Write-Host ""
Write-Host "GATE 5.0 OWNERSHIP ARTIFACT GENERATION - FAILED" `
-ForegroundColor Red
 
Write-Host (
"Reason=" +
$_.Exception.Message
) -ForegroundColor Red
 
Write-Host "NO GENERATED SQL WAS EXECUTED." `
-ForegroundColor Yellow
 
exit 1
}